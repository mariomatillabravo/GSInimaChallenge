# Copy this file to `.env` (git-ignored) in the same folder and adjust the values.

# Serve recorded AEMET responses instead of calling the real API. No API key is needed in demo mode.
DEMO_MODE=true
# Folder with the recorded responses, relative to the backend folder (uncomment to change).
# DEMO_DATA_DIR=sample_data/demo

# Logging: level (DEBUG, INFO, WARNING, ERROR) and format (text, or json with one object per line).
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# SQLite file of the cache, relative to the backend folder (uncomment to change). By default demo and
# real data use separate files: data/cache-demo.sqlite3 and data/cache.sqlite3.
# CACHE_DB_PATH=data/cache.sqlite3
# Minutes a month that can still change is served from the cache before fetching it again, and hours
# after a month ends during which AEMET may still add data (uncomment to change the defaults).
# CACHE_TTL_MINUTES=60
# CACHE_GRACE_HOURS=48
# After a failed fetch, seconds during which AEMET is not called and cached copies are served.
# UPSTREAM_COOLDOWN_SECONDS=60

# Personal AEMET OpenData API key, required when DEMO_MODE=false.
# Request one with a personal e-mail at https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=

# AEMET client tuning (uncomment to change the defaults).
# AEMET_BASE_URL=https://opendata.aemet.es/opendata
# AEMET_TIMEOUT_SECONDS=30
# AEMET_MAX_ATTEMPTS=3

# Longest range accepted for each aggregation level, in days of real elapsed time, so a range that
# crosses a daylight saving time change counts one hour more or less (uncomment to change the defaults).
# MAX_RANGE_DAYS_NONE=31
# MAX_RANGE_DAYS_HOURLY=366
# MAX_RANGE_DAYS_DAILY=3660
# MAX_RANGE_DAYS_MONTHLY=
