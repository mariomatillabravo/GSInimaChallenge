# Copy this file to `.env` (git-ignored) in the same folder and adjust the values.

# Serve recorded AEMET responses instead of calling the real API. No API key is needed in demo mode.
DEMO_MODE=true

# Personal AEMET OpenData API key, required when DEMO_MODE=false.
# Request one with a personal e-mail at https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=
